# Copy to .env (same directory) and fill in. NEVER commit the filled-in .env.
# Service-by-service setup notes are in ../../PROJECT_PLAN.md §9 — but read the
# banner at the top of that file first: it is a historical record, and the
# remove.bg / portrait-model keys it lists are no longer used.
#
# The homepage and demo harness (npm run homepage, npm run personalize) need ONLY
# REPLICATE_API_TOKEN — no database, no Redis, no storage.

# --- Database: PostgreSQL (Neon free tier) ---
# Required to run Day 1 (session storage) and `prisma migrate dev`.
# Recommended: append "&connect_timeout=30" — Neon's serverless compute can
# cold-start after idling, and Prisma's default connect timeout is too short
# for that, surfacing as an intermittent "Can't reach database server" error.
DATABASE_URL=

# --- Object storage: Cloudflare R2 (S3-compatible) ---
# Required to run Day 1 (presigned photo upload).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Queue: Redis (Upstash free tier) ---
# Not needed until Day 2 (BullMQ pipeline). Must use "rediss://" (TLS), not
# "redis://" — Upstash requires TLS; the plain scheme connects then resets.
REDIS_URL=

# --- The image engine: Replicate ---
# Required by every paid stage. Three models run per character, per page:
#   google/nano-banana        repaint   ~$0.039  <- dominates COST
#   swap (hosted GPU model)   swap      ~$0.0002-0.006 depending on model
#   CodeFormer                restore   ~$0.005, ~26-27s <- dominates LATENCY
# Budget roughly $0.045 per page per character.
#
# Pay-per-run, no subscription. Get a token at replicate.com/account/api-tokens
# after adding a payment method — whoever's funding this can create the token
# and hand it over, without sharing the account itself.
#
# LICENSING: the swap model (InsightFace inswapper, or a variant of it) is
# published for non-commercial/research use only. A commercial licence is
# required before this ships as a paid product — see "Known state" in ./README.md.
REPLICATE_API_TOKEN=

# Optional second Replicate account. The moment REPLICATE_API_TOKEN gets
# rate-limited, calls switch to this account immediately instead of backing
# off and waiting — see src/pipeline/replicate.ts. Which account gets tried
# first alternates per call (not always the primary), so a burst of
# concurrent calls (e.g. several pages rendering at once) spreads across both
# accounts' budgets instead of piling onto one. Leave unset to run with a
# single account, exactly as before this existed.
REPLICATE_API_TOKEN_FALLBACK=
# Replicate's rate limit is per ACCOUNT, not per process — this is the
# proactive throttle that paces call STARTS to stay under it (shared across
# every process via Redis when REDIS_URL is set). 6/min was measured against
# a different, low-credit account; verify the real limit on whichever
# account(s) you're actually using before assuming this number is accurate.
REPLICATE_RATE_LIMIT_PER_MIN=6

# --- Swap backend ---
# "replicate" (default) — hosted only. Defaults to the plain public model
# version (not the dedicated-GPU deployment, which is tied to one specific
# Replicate account — not a safe default now that calls can transparently
# switch between two different accounts on a rate limit). Nothing else needed.
# "local"     — services/faceswap only. Errors if that service is down.
#               For testing the local path in isolation.
# "auto"      — try local first, fall back to hosted on ANY local failure
#               (service down, error, or no-face after local retries).
#               This is the production setting: fast when the box is
#               healthy, degrades to slow-but-working when it isn't.
#
# The hosted call bills ~60 seconds of CPU for under a second of real inference
# — the rest is cold start. Self-hosted, the swap stage goes from ~55-90s to
# ~3.5s (measured), which takes a whole page from ~90-170s to ~15-25s.
#
# "local" and "auto" require services/faceswap running with its weights
# present; see services/faceswap/README.md. Leave unset to keep hosted-only.
SWAP_BACKEND=replicate
SWAP_LOCAL_URL=http://127.0.0.1:5175

# --- App config ---
# Comma-separated allowed origins for CORS. Browsers treat localhost and
# 127.0.0.1 as DIFFERENT origins even on the same port — both are listed for
# 5174 because the homepage server prints (and this repo's docs link)
# http://127.0.0.1:5174, not http://localhost:5174. Missing either one here
# means every upload/render call from that origin gets silently blocked by
# the browser after a "successful" CORS preflight — confirmed live, this
# exact gap broke a real personalization attempt during development.
CORS_ORIGIN=http://localhost:3000,http://localhost:5174,http://127.0.0.1:5174
PORT=3001
# Set to true ONLY when the API runs behind a reverse proxy / load balancer
# (Railway, Render, Fly…), so the per-IP rate limits see the real client IP
# from X-Forwarded-For instead of lumping every visitor into the proxy's IP.
# Leave false when clients hit the API directly (local dev), or they could
# spoof their IP via that header.
TRUST_PROXY=false

# --- Rate limits (src/rateLimit.ts) ---
# In-memory, per API process. If you ever run more than one API instance,
# move these to the plugin's Redis store first. Windows are in minutes.
# Magic-link + password-reset "send me a link": per IP and per email address.
# Counted the same whether or not the account exists, so the limit leaks
# nothing about which emails are registered.
RL_AUTH_LINK_IP_MAX=10
RL_AUTH_LINK_EMAIL_MAX=3
RL_AUTH_LINK_WINDOW_MIN=15
# Password login brute-force brake: per IP and per email. The per-email cap also
# lets a stranger lock a customer out of PASSWORD login for one window (magic
# link still works), so don't set it too low.
RL_LOGIN_IP_MAX=20
RL_LOGIN_EMAIL_MAX=10
RL_LOGIN_WINDOW_MIN=15
# POST /api/sessions per IP. Each session can go on to trigger paid renders.
# Note: the local homepage harness creates one session per personalization.
# Raise this locally if you're iterating fast.
RL_SESSION_CREATE_IP_MAX=10
RL_SESSION_CREATE_WINDOW_MIN=60
# DELETE /api/account/my-data per IP (GDPR account deletion, irreversible).
RL_MY_DATA_IP_MAX=5
RL_MY_DATA_WINDOW_MIN=60
# /api/admin/*: all requests per IP, and POSTs (retries, status changes, deletions) per IP, per window
RL_ADMIN_IP_MAX=600
RL_ADMIN_MUTATION_IP_MAX=60
RL_ADMIN_WINDOW_MIN=10

# How many sessions (whole-book renders) the pipeline worker (src/worker.ts)
# processes at once. Defaults to 1 in code if unset — meaning every render
# queues strictly behind whichever one started first, regardless of
# PAGE_CONCURRENCY/CHARACTER_CONCURRENCY underneath. Safe to raise because
# sessions.ts gives every render job a deterministic id, so a duplicate
# enqueue attempt (e.g. two upload-confirm calls landing close together)
# can't create two render jobs for the same session.
WORKER_CONCURRENCY=3

# How many paid orders the fulfilment worker (src/fulfillmentWorker.ts) works
# on at once (render wait → PDF → Gelato → emails). Defaults to 2 in code.
# These jobs mostly WAIT (on the render queue, R2, Gelato), so this doesn't
# compete with WORKER_CONCURRENCY for CPU. Runs in the same process as the
# pipeline worker (npm run dev, or npm run worker).
FULFILLMENT_CONCURRENCY=2

# Which of the 5 pipeline stages (repaint/swap/restore/heal/eyes) run
# in-process vs. as their own BullMQ job on their own queue:
#   direct (default) — everything runs in-process, no extra network hops
#                       between stages. Correct for a single machine.
#   queued            — each stage is its own BullMQ job, consumed by
#                       dedicated stage-worker.ts processes (npm run
#                       stage:repaint / stage:swap / ...). Only worth it once
#                       those processes actually run on SEPARATE machines, so
#                       a slow stage can get more dedicated capacity than a
#                       fast one — on one box it's pure overhead (extra R2 +
#                       Redis round trips per stage) with no payoff.
STAGE_EXECUTION=direct

# --- Stripe (test-mode keys until you're ready to go live) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Gelato print dispatch ---
GELATO_API_KEY=
GELATO_PRODUCT_UID=
# Shared secret Gelato sends in the x-gelato-webhook-secret header. Compared in
# constant time. The webhook FAILS CLOSED: leave this empty and
# /api/webhooks/gelato rejects every request with 401.
GELATO_WEBHOOK_SECRET=
# Dev only. "true" makes /api/webhooks/gelato accept UNSIGNED requests while no
# secret is set (e.g. to replay a captured payload locally). A warning is
# logged at startup whenever it's on. Never set this in production.
GELATO_WEBHOOK_ALLOW_UNSIGNED=false

# --- Resend transactional email ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=orders@yourdomain.com

# --- Print PDF trim size, in inches ---
PRINT_TRIM_WIDTH_IN=8.5
PRINT_TRIM_HEIGHT_IN=8.5

# --- Authentication & customer accounts ---
# Frontend origin, used to build the links in activation / magic-link / reset
# emails (e.g. https://app.yourdomain.com). Must match where apps/web is served.
APP_BASE_URL=http://localhost:3000
# The API's own public origin — magic-link emails point here first (to set the
# session cookie) before redirecting to APP_BASE_URL. Defaults to localhost:PORT.
API_PUBLIC_URL=http://localhost:3001
# Session cookie hardening. In production set AUTH_COOKIE_SECURE=true. If the API
# and frontend are on genuinely cross-SITE domains (not just different ports),
# set AUTH_COOKIE_SAMESITE=none (which requires secure=true to be honoured).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Optional explicit cookie domain, e.g. .yourdomain.com to share api. and www.
# Leave unset for localhost (host-only cookie).
AUTH_COOKIE_DOMAIN=
# Browser session lifetime, in days.
AUTH_SESSION_TTL_DAYS=30

# --- Personalization session expiry (GDPR) ---
# Hours a personalization session lives after its last activity (sliding:
# each upload-confirm / render-full pushes it forward). Milestone 4's deletion
# Pathway 1 removes raw photo uploads 24h after this expiry. Sessions attached
# to an order are never treated as expired. Unrelated to AUTH_SESSION_TTL_DAYS
# (the login cookie). 72 is a placeholder; the real value is a client decision.
SESSION_TTL_HOURS=72

# --- GDPR photo deletion (src/gdpr/) ---
# DRY RUN BY DEFAULT. While this is anything other than exactly "false", the
# automated sweeper (Pathway 1: raw photos of unordered sessions, 24h after
# expiry; Pathway 2: raw photos 24h and processed files 30 days after delivery)
# deletes NOTHING and only writes DeletionAuditLog rows (dryRun=true) saying
# what it would delete. Check those rows, then set false to delete for real.
# The customer's own DELETE /api/account/my-data is not affected by this flag.
GDPR_DELETION_DRY_RUN=true
# How often the hourly sweep job runs (minutes), how many sessions each
# candidate query fetches, and the most sessions examined per pathway per run
# (the rest wait for the next run, so one run stays bounded).
GDPR_SWEEP_INTERVAL_MINUTES=60
GDPR_SWEEP_BATCH_SIZE=50
GDPR_SWEEP_MAX_PER_RUN=1000
